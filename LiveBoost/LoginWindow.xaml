<Window x:Class="LiveBoost.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveBoost - Sign in" Icon="Tools/EARL_TWEAKS.ico" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
  <Border Background="{StaticResource Panel}" CornerRadius="12" Margin="22" Padding="28">
    <StackPanel>
      <Image Source="Tools/EARL_TWEAKS.ico" Width="56" Height="56" HorizontalAlignment="Left" Margin="0,0,0,10"/>
      <TextBlock x:Name="Heading" Text="Sign in to LiveBoost" FontSize="24" FontWeight="Bold"/>
      <TextBlock x:Name="SubHeading" Text="Use the username and password provided by your administrator." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,16"/>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
        <RadioButton x:Name="UserLoginRb" GroupName="Portal" Content="User login" IsChecked="True" Checked="Portal_Changed" Margin="0,0,22,0" FontSize="14" Foreground="{StaticResource Text}"/>
        <RadioButton x:Name="AdminLoginRb" GroupName="Portal" Content="Admin login" Checked="Portal_Changed" FontSize="14" Foreground="{StaticResource Text}"/>
      </StackPanel>

      <TextBlock Text="Username" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
      <TextBox x:Name="UserBox" FontSize="15" Padding="8,7" MaxLength="32"/>

      <TextBlock Text="Password" Foreground="{StaticResource Muted}" Margin="0,12,0,4"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <PasswordBox x:Name="PwdBox" FontSize="15" Padding="8,7" MaxLength="128"/>
        <TextBox x:Name="PwdText" FontSize="15" Padding="8,7" Visibility="Collapsed" MaxLength="128"/>
        <Button x:Name="ShowBtn" Grid.Column="1" Content="Show" Click="Show_Click" Margin="8,0,0,0" Padding="12,6" Width="64"/>
      </Grid>

      <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
        <TextBlock Text="Confirm password" Foreground="{StaticResource Muted}" Margin="0,12,0,4"/>
        <PasswordBox x:Name="ConfirmBox" FontSize="15" Padding="8,7" MaxLength="128"/>
      </StackPanel>

      <TextBlock x:Name="ErrorText" Foreground="OrangeRed" TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="18"/>
      <Button x:Name="ActionBtn" Style="{StaticResource Primary}" Content="Sign in" IsDefault="True" Click="Action_Click" Margin="0,12,0,0"/>
      <TextBlock x:Name="Busy" Text="Checking..." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
      <Button Content="Exit" Click="Exit_Click" IsCancel="True" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="22,5"/>
    </StackPanel>
  </Border>
</Window>
