<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LiveBoost</AssemblyName>
    <Version>1.5.0</Version>
    <ApplicationIcon>Tools\EARL_TWEAKS.ico</ApplicationIcon>
    <Product>LiveBoost FPS Optimizer</Product>
    <AssemblyTitle>LiveBoost FPS Optimizer</AssemblyTitle>
    <Description>FPS booster, live-stream optimizer and system monitor</Description>
    <Company>LiveBoost</Company>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Tools\EARL_TWEAKS.ico" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Tools\EARL_TWEAKS.exe" LogicalName="EARL_TWEAKS.exe" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>
</Project>